// Kiota dev container. See .devcontainer/README.md for what is in it and how to use it.
// Tool versions mirror what CI tests with (global.json, .github/workflows/*.yml, it/*/ manifests).
{
  "name": "Kiota",
  // Ubuntu 26.04, the OS of CI's Ubuntu runners. Image major pinned so the OS cannot change underneath us.
  "image": "mcr.microsoft.com/devcontainers/base:3-resolute",
  "customizations": {
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "ms-dotnettools.csharp",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vscjava.vscode-java-pack",
        "waderyan.gitblame",
        "eamodio.gitlens",
        "codezombiech.gitignore",
        "golang.go",
        "ms-vsliveshare.vsliveshare",
        "ms-vscode.powershell",
        "Shopify.ruby-lsp",
        "streetsidesoftware.code-spell-checker",
        "ms-dotnettools.csdevkit",
        "github.vscode-github-actions",
        "42Crunch.vscode-openapi",
        "redhat.vscode-yaml",
        "github.vscode-pull-request-github",
        "amodio.tsl-problem-matcher",
        "ms-vscode.extension-test-runner",
        // Not needed here: two more PHP language servers and autopep8, which the PHP and Python features add.
        "-devsense.phptools-vscode",
        "-xdebug.php-pack",
        "-ms-python.autopep8"
      ],
      "settings": {
        // it/dart builds only after an integration-test run generates lib/; it/exec-cmd.ps1 runs pub get then.
        "dart.promptToGetPackages": false
      }
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2"
    },
    // A dedicated Python (not Ubuntu's externally-managed one), so pip install works as in CI.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    },
    // Go integration tests (go.mod) and the gofmt check in Kiota.Builder.IntegrationTests (CI: go stable).
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27",
      "installGoTools": false
    },
    // Java integration tests and MockServer (Maven). CI uses Temurin 17; nothing in the repo uses Gradle.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.9",
      "installGradle": false
    },
    // The integration test scripts in it/ are PowerShell. 7.6 is the current LTS, as on the CI runners.
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "7.6"
    },
    // .NET SDK from the feature (not a dotnet base image): it always gets the newest 10.0 SDK at build time,
    // which is what CI's setup-dotnet resolves for global.json (rollForward: latestMinor).
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    // VS Code extension (vscode/) and TypeScript integration tests: CI uses node-version 24.x.
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/ruby:2": {
      "version": "3.3"
    },
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.2",
      "installComposer": true
    },
    // Newest Dart 3.x: it/dart/pubspec.yaml requires sdk ^3.x, and CI uses the latest stable.
    // No maintained Dart feature exists in the devcontainers GitHub organization; see features/dart/install.sh.
    "./features/dart": {
      "version": "3"
    },
    // Headless display and Electron libraries for the VS Code extension tests (xvfb-run -a npm run test:vscode).
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "xvfb,libgtk-3-0t64,libgbm1,libnss3,libasound2t64,libxkbfile1"
    }
  },
  // Each feature is one image layer, and changing a feature rebuilds every layer after it. Install the slow,
  // rarely changing ones first (PHP, Ruby and Python compile from source) so a version bump of a quick feature
  // does not recompile them. Features not listed here install afterwards.
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/php",
    "ghcr.io/devcontainers/features/ruby",
    "ghcr.io/devcontainers/features/python",
    "ghcr.io/rocker-org/devcontainer-features/apt-packages",
    "ghcr.io/devcontainers/features/java",
    "ghcr.io/devcontainers/features/go",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/devcontainers/features/powershell",
    "ghcr.io/devcontainers/features/github-cli",
    "./features/dart",
    "ghcr.io/devcontainers/features/dotnet"
  ],
  // Docker sets an unlimited core size; on hosts whose kernel writes core files to the working directory,
  // a crashing process would otherwise drop a multi-hundred-MB file into the repository.
  "runArgs": ["--ulimit", "core=0"],
  "containerEnv": {
    // As in Microsoft's .NET SDK images: no first-run banner, no ASP.NET HTTPS certificate (nothing here uses it).
    "DOTNET_NOLOGO": "true",
    "DOTNET_GENERATE_ASPNET_CERTIFICATE": "false",
    // The workload check warns because the SDK directory is root-owned; this repository uses no workloads.
    "DOTNET_SKIP_WORKLOAD_INTEGRITY_CHECK": "true",
    // Xdebug is installed with the PHP feature; enable it per run with XDEBUG_MODE=debug or coverage.
    "XDEBUG_MODE": "off"
  },
  // Runs once when the container is created (and in Codespaces prebuilds).
  "onCreateCommand": {
    "reportgenerator": "dotnet tool update --global dotnet-reportgenerator-globaltool --version '5.*'",
    "dotnet-outdated": "dotnet tool update --global dotnet-outdated-tool --version '4.*'"
  },
  // Runs after onCreate and whenever a prebuild picks up new content: restore so the first build and test are fast.
  "updateContentCommand": {
    "dotnet": "dotnet restore kiota.slnx",
    "npm": "npm ci --prefix vscode"
  },
  "portsAttributes": {
    "1080": {
      "label": "MockServer (integration tests)",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
